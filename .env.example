# Database
DATABASE_URL=postgresql://rena_user:rena_password@localhost:5432/rena_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=rena_user
DATABASE_PASSWORD=rena_password
DATABASE_NAME=rena_db

# Redis
REDIS_URL=redis://localhost:6379

# API Server
API_PORT=3001
API_HOST=localhost
NODE_ENV=development

# Frontend
REACT_APP_API_URL=http://localhost:3001
REACT_APP_API_TIMEOUT=30000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# File Upload
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,txt,csv

# OCR Service (optional)
OCR_API_KEY=
OCR_API_URL=

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
